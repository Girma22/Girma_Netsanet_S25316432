<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgSituationIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_roadworks"
        android:contentDescription="Roadworks icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">



        <TextView
            android:id="@+id/txtSituationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Road name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#424B57"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtSituationDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:paddingTop="4dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtSituationDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delay"
            android:textStyle="bold"
            android:paddingTop="5dp" />

    </LinearLayout>

</LinearLayout>
